
import plotly.graph_objects as go


def create_facility_3d():

    # Conceptual equipment positions.
    equipment = [
        {
            "name": "Production Wells",
            "x": 0, "y": 0, "z": 0,
            "color": "#3498db",
            "size": 15
        },
        {
            "name": "Three-Phase Separator",
            "x": 2, "y": 0, "z": 0,
            "color": "#f39c12",
            "size": 19
        },
        {
            "name": "Oil Treatment",
            "x": 4, "y": -1, "z": 0,
            "color": "#e67e22",
            "size": 17
        },
        {
            "name": "Gas Compressor",
            "x": 4, "y": 1, "z": 1,
            "color": "#9b59b6",
            "size": 17
        },
        {
            "name": "Gas Treatment",
            "x": 6, "y": 1, "z": 1,
            "color": "#1abc9c",
            "size": 17
        },
        {
            "name": "Oil Storage",
            "x": 6, "y": -1, "z": 0,
            "color": "#e74c3c",
            "size": 19
        },
        {
            "name": "Water Treatment",
            "x": 4, "y": -2, "z": -1,
            "color": "#2980b9",
            "size": 17
        },
        {
            "name": "Gas Export Pipeline",
            "x": 8, "y": 1, "z": 1,
            "color": "#2ecc71",
            "size": 15
        }
    ]

    # Conceptual process connections.
    connections = [
        ("Production Wells", "Three-Phase Separator"),
        ("Three-Phase Separator", "Oil Treatment"),
        ("Three-Phase Separator", "Gas Compressor"),
        ("Three-Phase Separator", "Water Treatment"),
        ("Oil Treatment", "Oil Storage"),
        ("Gas Compressor", "Gas Treatment"),
        ("Gas Treatment", "Gas Export Pipeline")
    ]

    equipment_lookup = {
        item["name"]: item for item in equipment
    }

    fig = go.Figure()

    # Draw process pipelines.
    for start_name, end_name in connections:

        start = equipment_lookup[start_name]
        end = equipment_lookup[end_name]

        fig.add_trace(
            go.Scatter3d(
                x=[start["x"], end["x"]],
                y=[start["y"], end["y"]],
                z=[start["z"], end["z"]],
                mode="lines",
                line=dict(
                    color="#7f8c8d",
                    width=7
                ),
                hoverinfo="skip",
                showlegend=False
            )
        )

    # Draw equipment.
    fig.add_trace(
        go.Scatter3d(
            x=[item["x"] for item in equipment],
            y=[item["y"] for item in equipment],
            z=[item["z"] for item in equipment],
            mode="markers+text",
            text=[item["name"] for item in equipment],
            textposition="top center",
            textfont=dict(
                color="white",
                size=10
            ),
            marker=dict(
                size=[item["size"] for item in equipment],
                color=[item["color"] for item in equipment],
                line=dict(
                    color="white",
                    width=1
                ),
                opacity=0.95
            ),
            hovertemplate=(
                "<b>%{text}</b><br>"
                "X: %{x}<br>"
                "Y: %{y}<br>"
                "Z: %{z}"
                "<extra></extra>"
            ),
            showlegend=False
        )
    )

    fig.update_layout(
        title=dict(
            text="3D OIL & GAS PROCESSING FACILITY",
            font=dict(
                size=20,
                color="white"
            )
        ),
        height=650,
        margin=dict(
            l=0,
            r=0,
            t=60,
            b=0
        ),
        paper_bgcolor="#111111",
        scene=dict(
            bgcolor="#111111",
            xaxis=dict(
                title="Facility Layout",
                showbackground=False,
                showgrid=True,
                gridcolor="#333333",
                color="white"
            ),
            yaxis=dict(
                title="",
                showbackground=False,
                showgrid=True,
                gridcolor="#333333",
                color="white"
            ),
            zaxis=dict(
                title="",
                showbackground=False,
                showgrid=True,
                gridcolor="#333333",
                color="white"
            ),
            aspectmode="manual",
            aspectratio=dict(
                x=2.2,
                y=1.2,
                z=0.8
            ),
            camera=dict(
                eye=dict(x=1.7, y=1.7, z=1.2)
            )
        ),
        showlegend=False
    )

    return fig
