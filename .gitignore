# Exclude original raw datasets
data/raw/*
!data/raw/.gitkeep

# Python virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]

# Jupyter temporary files
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*

# Operating system files
.DS_Store
Thumbs.db

# Exclude processed datasets
data/processed/*
!data/processed/.gitkeep

# Exclude trained model files
models/*
!models/.gitkeep

